<?xml version="1.0" encoding="UTF-8"?>
<ejb-jar xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/ejb-jar_4_0.xsd"
	version="4.0">
	<module-name>ir-ejb</module-name>
	<display-name>ir-ejb</display-name>
	<enterprise-beans>
		<session>
			<ejb-name>FutureTradeServiceBean</ejb-name>
			<ejb-class>
				org.eclipse.tradista.ir.future.service.FutureTradeServiceBean</ejb-class>
			<session-type>Stateless</session-type>
		</session>
		<session>
			<ejb-name>FRATradeServiceBean</ejb-name>
			<ejb-class>org.eclipse.tradista.ir.fra.service.FRATradeServiceBean</ejb-class>
			<session-type>Stateless</session-type>
		</session>
		<session>
			<ejb-name>CcySwapTradeServiceBean</ejb-name>
			<ejb-class>
				org.eclipse.tradista.ir.ccyswap.service.CcySwapTradeServiceBean</ejb-class>
			<session-type>Stateless</session-type>
		</session>
		<session>
			<ejb-name>IRCapFloorCollarTradeServiceBean</ejb-name>
			<ejb-class>
				org.eclipse.tradista.ir.ircapfloorcollar.service.IRCapFloorCollarTradeServiceBean</ejb-class>
			<session-type>Stateless</session-type>
		</session>
		<session>
			<ejb-name>IRSwapTradeServiceBean</ejb-name>
			<ejb-class>
				org.eclipse.tradista.ir.irswap.service.IRSwapTradeServiceBean</ejb-class>
			<session-type>Stateless</session-type>
		</session>
		<session>
			<ejb-name>IRSwapOptionTradeServiceBean</ejb-name>
			<ejb-class>
				org.eclipse.tradista.ir.irswapoption.service.IRSwapOptionTradeServiceBean</ejb-class>
			<session-type>Stateless</session-type>
		</session>
	</enterprise-beans>
	<interceptors>
		<interceptor>
			<interceptor-class>org.eclipse.tradista.core.common.service.TradistaSegregationHandlerInterceptor</interceptor-class>
		</interceptor>
		<interceptor>
			<interceptor-class>org.eclipse.tradista.core.common.service.TradistaExceptionHandlerInterceptor</interceptor-class>
		</interceptor>
		<interceptor>
			<interceptor-class>org.eclipse.tradista.core.trade.service.TradistaProductScopeHandlerInterceptor</interceptor-class>
		</interceptor>
	</interceptors>
	<assembly-descriptor>
		<interceptor-binding>
			<ejb-name>*</ejb-name>
			<interceptor-class>org.eclipse.tradista.core.common.service.TradistaSegregationHandlerInterceptor</interceptor-class>
		</interceptor-binding>
		<interceptor-binding>
			<ejb-name>*</ejb-name>
			<interceptor-class>org.eclipse.tradista.core.common.service.TradistaExceptionHandlerInterceptor</interceptor-class>
		</interceptor-binding>
		<interceptor-binding>
			<ejb-name>*</ejb-name>
			<interceptor-class>org.eclipse.tradista.core.trade.service.TradistaProductScopeHandlerInterceptor</interceptor-class>
		</interceptor-binding>
	</assembly-descriptor>
</ejb-jar>
